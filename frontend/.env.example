# GeoAgent Frontend Environment Variables

# Backend API URL - Change to your backend server address
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Google Maps JavaScript API key (enable Maps JavaScript API and restrict by referrer)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Optional: Map configuration (for MapLibre GL)
NEXT_PUBLIC_MAP_API_KEY=

# Optional: LLM configuration
NEXT_PUBLIC_LLM_ENABLED=false

# Optional: Application environment
NEXT_PUBLIC_APP_ENV=development
