# ===== Application Settings =====
APP_NAME=GeoAgent
ENV=development
DEBUG=True
LOG_LEVEL=INFO
API_VERSION=v1

# ===== Server Settings =====
HOST=0.0.0.0
PORT=8000
WORKERS=4

# ===== Database =====
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/geoagent
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_ECHO=False
DATABASE_POOL_TIMEOUT=30

# ===== Redis =====
REDIS_URL=redis://localhost:6379/0

# ===== Security & JWT =====
JWT_SECRET=your-secret-key-change-this-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ===== Password Policy =====
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_SPECIAL=True

# ===== OTP Settings =====
OTP_EXPIRY_MINUTES=10
OTP_LENGTH=6

# ===== Email Verification =====
EMAIL_VERIFICATION_EXPIRY_HOURS=24

# ===== Location Tracking =====
LOCATION_UPDATE_INTERVAL_SECONDS=5
LOCATION_RETENTION_DAYS=30
GPS_ACCURACY_THRESHOLD_METERS=5.0
MAX_GPS_JUMP_METERS=500.0
MIN_MEANINGFUL_MOVEMENT_METERS=5.0

# ===== WebSocket =====
WEBSOCKET_HEARTBEAT_INTERVAL=30
WEBSOCKET_MAX_CONNECTIONS_PER_USER=5

# ===== Demo Mode =====
DEMO_MODE_ENABLED=True
DEMO_DEVICE_ID=DEMO-01

# ===== LLM Configuration =====
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-your-api-key
LLM_MODEL=gpt-4-turbo-preview
LLM_TEMPERATURE=0.7

# ===== Satellite Providers =====
SATELLITE_PROVIDER=landsat
LANDSAT_API_KEY=your-landsat-key
SENTINEL_CLIENT_ID=your-sentinel-client-id
SENTINEL_CLIENT_SECRET=your-sentinel-client-secret

# ===== CORS =====
CORS_ORIGINS=["http://localhost:3000", "http://localhost:3001", "http://127.0.0.1:3000", "http://localhost:5173"]
CORS_CREDENTIALS=True

# ===== Rate Limiting =====
RATE_LIMIT_ENABLED=True
RATE_LIMIT_REQUESTS=1000
RATE_LIMIT_PERIOD_SECONDS=60
